# Copy to terraform.tfvars (git-ignored) and fill in your own values.
# Use the same profile and account as the foundation stack.

aws_profile         = "<your-aws-cli-profile>"
allowed_account_ids = ["<your-12-digit-account-id>"]

# Optional overrides (defaults shown):
# region                = "eu-north-1"
# foundation_state_path = "../foundation/terraform.tfstate"
